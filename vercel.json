{
  "crons": [
    { "path": "/api/app?action=run", "schedule": "45 6 * * *" },
    { "path": "/api/app?action=run_escalations", "schedule": "*/5 * * * *" }
  ],
  "rewrites": [
    { "source": "/gps/:secret", "destination": "/api/app?action=gps&secret=:secret" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    }
  ]
}
